void loop() {
  displayletter(letterH, 1000);
  displayletter(letterE, 1000);
  displayletter(letterL, 1000);
  displayletter(letterL, 1000);
  displayletter(letterO, 1000);
  mled.clear();
  mled.display();
  displayletter(letterW, 1000);
  displayletter(letterO, 1000);
  displayletter(letterR, 1000);
  displayletter(letterL, 1000);
  displayletter(letterD, 1000);
  mled.clear();
  mled.display();
}

void displayletter(int letters[],int duration) {
  mled.clear();
  mled.display();
  for (int i = 0; i < 8; i++) {
    mled.disBuffer[i]=letters[i];
  }
  mled.display();
delay(duration);
}

