void setup() {
  Serial.begin(9600);
  display.begin(SSD1306_SWITCHCAPVCC, 0x3C);  // initialize with the I2C addr 0x3D (for the 128x64)
  // Clear the buffer.
  display.clearDisplay();
  //delay(4000);

  display.clearDisplay();
  display.drawBitmap(0, (32 - (ImageHeight1 / 2)),  ImageArray1, ImageWidth1, ImageHeight1, 1);
  display.display();

 
}

void loop() {
  
 delay(500);
      
        display.clearDisplay();
        display.drawBitmap(0, (32 - (ImageHeight1 / 2)),  ImageArray2, ImageWidth1, ImageHeight1, 1);
        display.display();
delay(500);
      
        display.clearDisplay();
        display.drawBitmap(0, (32 - (ImageHeight1 / 2)),  ImageArray1, ImageWidth1, ImageHeight1, 1);
        display.display();

delay(500);    
        display.clearDisplay();
        display.drawBitmap(0, (32 - (ImageHeight1 / 2)),  ImageArray2, ImageWidth1, ImageHeight1, 1);
        display.display();
delay(500);
    
        display.clearDisplay();
        display.drawBitmap(0, (32 - (ImageHeight1 / 2)),  ImageArray1, ImageWidth1, ImageHeight1, 1);
        display.display();

       

}
